{
  "name": "@kryard/sdk",
  "version": "0.4.0",
  "description": "Gasless, sponsored transactions via a managed EIP-7702 relay + a Turnkey-compatible EVM signer. Pay gas in any ERC-20 token. Built-in X-Stamp signer; viem peer dep.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "license": "MIT",
  "author": "foreseerco",
  "keywords": [
    "kryard",
    "wallet-infrastructure",
    "signing",
    "secp256k1",
    "key-management",
    "hpke",
    "key-export",
    "turnkey",
    "turnkey-compatible",
    "eip-7702",
    "7702",
    "relayer",
    "paymaster",
    "gasless",
    "sponsored-transaction",
    "account-abstraction",
    "viem",
    "ethereum",
    "web3",
    "erc-20-gas",
    "x-stamp",
    "turnkey-alternative"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kryard/sdk.git",
    "directory": "packages/typescript"
  },
  "homepage": "https://docs.kryard.com",
  "bugs": "https://github.com/Kryard/sdk/issues",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "viem": "^2.21.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
